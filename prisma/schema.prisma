generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Message {
  id        String    @id @default(cuid())
  username  String    @db.VarChar(40)
  content   String    @db.Text
  ip        String?   @db.VarChar(64)
  userAgent String?   @db.Text
  visible   Boolean   @default(true)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([createdAt])
  @@index([ip])
  @@index([visible])
}

model BannedIp {
  id        String   @id @default(cuid())
  ip        String   @unique @db.VarChar(64)
  reason    String?  @db.VarChar(255)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
}

model SiteSetting {
  id              String    @id @default("singleton")
  messageEnabled  Boolean   @default(true)
  openStartTime   DateTime?
  openEndTime     DateTime?
  closedNotice    String    @default("留言暂未开放，链上窗口正在等待下一个区块。") @db.VarChar(200)
  timezone        String    @default("Asia/Shanghai") @db.VarChar(64)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model VisitLog {
  id        String   @id @default(cuid())
  ip        String?  @db.VarChar(64)
  userAgent String?  @db.Text
  path      String?  @db.VarChar(255)
  createdAt DateTime @default(now())

  @@index([ip])
  @@index([createdAt])
}

model AdminUser {
  id           String   @id @default(cuid())
  username     String   @unique @db.VarChar(40)
  passwordHash String   @db.VarChar(255)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
